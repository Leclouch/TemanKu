# ── Flutter / Dart ────────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.worktrees/
.flutter-plugins
.flutter-plugins-dependencies
migrate_working_dir/
**/doc/api/
*.log

# NOTE: pubspec.lock is deliberately NOT ignored. This is an application, not a
# package — committing the lockfile is what keeps IT-1 and IT-2 on byte-identical
# dependency versions. On a 5-day clock, "works on my machine" from a silent
# transitive bump is a day you do not have.
#
# .metadata is also deliberately committed — Flutter uses it to know which
# platform scaffolds exist when upgrading.

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ── Secrets / per-developer config — never commit ─────────────────────────────
# Generated by `flutterfire configure`, contains this developer's project keys.
lib/firebase_options.dart
google-services.json
GoogleService-Info.plist
.env
.env.*
secrets.json
secrets.*.json
!.env.example

# Firebase CLI + local emulator state. IT-2 will run the Firestore emulator for
# the contract tests; its logs and seeded data must not reach the repo.
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log
firestore_export/

# Android signing lives in android/.gitignore too, repeated here as a backstop.
key.properties
**/*.keystore
**/*.jks

# ── Child data — source-of-truth §10 / UU PDP Pasal 25 ────────────────────────
# Photos are of real children in their real homes and are local-only by design.
# Nothing captured at runtime or during testing may ever be committed. Fixture
# images belong in assets/ and must be synthetic or licensed, never a real child.
*.hive
*.lock
!pubspec.lock
/local_photos/
/child_data/
**/session_logs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
